# Add these to .gitignore if not already there
cat >> .gitignore << 'EOF'

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build directories
build/
dist/
out/
.next/
.client/build/

# Environment variables
.env
.env.local
.env*.local

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Test coverage
coverage/
.nyc_output/

# Logs
logs/
*.log
EOF